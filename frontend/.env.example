# Coreed Platform Environment Variables
# Copy this to .env.local and configure for your environment

# =============================================================================
# REQUIRED: 0G Configuration
# =============================================================================

# 0G Galileo Testnet RPC
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai

# Chain ID
NEXT_PUBLIC_CHAIN_ID=16602

# =============================================================================
# REQUIRED: Smart Contract Addresses
# =============================================================================

NEXT_PUBLIC_MODEL_REGISTRY_ADDRESS=0xFA81366Ba81C19d848191B8e49eC0948230d4216
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0xff34F1281A8D4F14d503c28E8A45cAF98Acc235C
NEXT_PUBLIC_AGENT_SPACE_REGISTRY_ADDRESS=0xedF4958de1e22979EaE3dec3ECb84C4D63cA510A

# =============================================================================
# REQUIRED: 0G Services
# =============================================================================

# Storage Indexer
NEXT_PUBLIC_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Compute Router
NEXT_PUBLIC_COMPUTE_ROUTER=https://router-api.0g.ai/v1

# YOUR 0G Compute API Key
# Get it from: https://pc.0g.ai
# Deposit tokens at: https://pc.0g.ai
OG_COMPUTE_API_KEY=your-0g-compute-api-key-here

# =============================================================================
# Application Settings
# =============================================================================

# Server port
PORT=3000

# Git repository storage path
REPO_STORAGE_PATH=./storage/repos

# Application domain for URL provisioning
# For local dev: localhost
# For production: your-domain.com (e.g., coreed.ai)
NEXT_PUBLIC_APP_DOMAIN=localhost

# Webhook URL (optional, for future CI/CD)
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:3000

# =============================================================================
# Optional: For Production Deployment
# =============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/coreed
# SESSION_SECRET=your-secret-key
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=https://your-domain.com

# =============================================================================
# Notes
# =============================================================================

# 1. OG_COMPUTE_API_KEY is REQUIRED for AI inference
#    Get from: https://pc.0g.ai
#    You must have tokens deposited
#
# 2. Each generated space app.py will require YOU to set OG_COMPUTE_API_KEY
#    The API key is NOT hardcoded - users must provide their own
#
# 3. Provisioned URLs follow format:
#    https://{owner-8chars}.{space-slug}.{NEXT_PUBLIC_APP_DOMAIN}
#
# 4. Git repos are stored at: {REPO_STORAGE_PATH}/{owner}/{space-slug}/
