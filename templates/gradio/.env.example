# Coreed Agent Space - Gradio Configuration

# Required: Path to your model file (downloaded from 0G Storage)
MODEL_PATH=./models/model.gguf

# Required: Your Coreed Space ID (from deployment)
SPACE_ID=1

# Optional: Name of your model/agent
MODEL_NAME=My Gradio Agent

# Optional: Version of your agent
SPACE_VERSION=1.0.0

# Optional: Server port (default: 7860)
SERVER_PORT=7860

# Optional: Gradio server name (default: 0.0.0.0)
GRADIO_SERVER_NAME=0.0.0.0

# Optional: Sleep Management
# Sleep timeout in seconds (default: 3600 = 60 minutes)
COREED_SLEEP_TIMEOUT=3600
# Enable auto-sleep when inactive (default: true)
COREED_AUTO_SLEEP=true
# Enable auto-wake on request (default: true)
COREED_AUTO_WAKE=true
