# Wallet private key (with OG testnet balance) used to sign deployment transactions.
# Get free testnet OG from the Galileo faucet: https://docs.0g.ai (check current faucet link)
# NEVER commit a real key. This file should stay in .gitignore.
PRIVATE_KEY=
# Override only if 0G's docs show a different current endpoint
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai

# IMPORTANT: confirm this against https://docs.0g.ai before deploying.
# Public sources disagreed (16601 vs 16602) as of mid-2026 due to testnet
# resets. Using the wrong chain ID will make Hardhat reject the network
# or sign transactions for the wrong chain.
GALILEO_CHAIN_ID=16602

# Optional, for contract verification on chainscan-galileo.0g.ai
CHAINSCAN_API_KEY=
